# Copy to .env and fill in. Never commit .env.

# Base URL of the Shinobi web UI/API, e.g. http://localhost:8080
SHINOBI_URL=

# Values marked (generated) are written by `scripts/shinobi_bootstrap.py apply` (permissions in
# shinobi-config/account.yaml); leave them empty on a fresh install.

# (generated) Read-only API key: services, CLI, tests, WebSocket.
SHINOBI_API_KEY=

# (generated) Second API key for scripts/provision_monitors.py: Get Monitors + Edit Monitors only.
# Kept separate so services that only read keep a key that cannot change monitors.
SHINOBI_EDIT_API_KEY=

# Group key (ke) of the account. Chosen by you for a NEW account (letters and digits; empty = Shinobi
# generates one); for an existing account the bootstrap writes the real value here.
SHINOBI_GROUP_KEY=

# (generated) User id of the account that owns the API keys ("uid" in the login answer). Needed to
# authenticate the WebSocket (socket.io "init" checks ke + uid + key). Not a secret.
SHINOBI_UID=

# Shinobi image digest (registry.gitlab.com/shinobi-systems/shinobi). "dev" is a moving tag, so pin
# it: docker buildx imagetools inspect registry.gitlab.com/shinobi-systems/shinobi:dev
SHINOBI_DIGEST=sha256:aa5cd83224a7d01df9b1b56d2eb637d005a3659fd97ddeeb5603f9076f08014a

# Superuser (/super panel; stored as a hash in data/shinobi/super.json). Choose them here; the
# bootstrap replaces the image default admin@shinobi.video / admin with them.
SHINOBI_SUPER_EMAIL=
SHINOBI_SUPER_PASSWORD=

# Admin account (stored in the Shinobi database); created by the bootstrap if missing.
SHINOBI_ADMIN_EMAIL=
SHINOBI_ADMIN_PASSWORD=

# YoloV9 ONNX object detection plugin (services/yolo-plugin). Pinned like SHINOBI_DIGEST:
# docker buildx imagetools inspect registry.gitlab.com/shinobi-systems/shinobi-plugins/yolo-v9-onnx:cpu
YOLO_PLUGIN_DIGEST=sha256:c930b586f458e72071404b878cf401886bab110e6afc56cbe721a43290704b72

# (generated) Pairing key between Shinobi (conf.json pluginKeys.YoloV9) and the plugin. Written by
# scripts/shinobi-seed.sh when empty; change it = `docker compose up -d shinobi yolo`.
SHINOBI_PLUGIN_KEY=

# Optional plugin tuning (defaults in docker-compose.yml): YOLO_CONFIDENCE=0.5 YOLO_THREADS=2 YOLO_CPUS=2

# MQTT broker URL, e.g. mqtt://localhost:1883
MQTT_URL=

# MediaMTX image tag (bluenviron/mediamtx on Docker Hub; tags have no "v" prefix)
MTX_TAG=1.21.1
