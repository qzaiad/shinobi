# Copy to .env and fill in. Never commit .env.

# Base URL of the Shinobi web UI/API, e.g. http://localhost:8080
SHINOBI_URL=

# API key created in the Shinobi UI (API section of your account)
SHINOBI_API_KEY=

# Group key of your Shinobi account (shown in account settings)
SHINOBI_GROUP_KEY=

# MQTT broker URL, e.g. mqtt://localhost:1883
MQTT_URL=

# MediaMTX image tag (bluenviron/mediamtx on Docker Hub; tags have no "v" prefix)
MTX_TAG=1.21.1
