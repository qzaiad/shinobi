# Copy to .env and fill in. Never commit .env.

# Base URL of the Shinobi web UI/API, e.g. http://localhost:8080
SHINOBI_URL=

# API key created in the Shinobi UI (API section of your account)
SHINOBI_API_KEY=

# Second API key for scripts/provision_monitors.py: permissions Get Monitors + Edit Monitors only.
# Kept separate so services that only read keep a key that cannot change monitors.
SHINOBI_EDIT_API_KEY=

# Group key of your Shinobi account (shown in account settings)
SHINOBI_GROUP_KEY=

# User id of the account that owns the API key ("uid" in the login answer). Needed to
# authenticate the WebSocket (socket.io "init" checks ke + uid + key). Not a secret.
SHINOBI_UID=

# Shinobi image digest (registry.gitlab.com/shinobi-systems/shinobi). "dev" is a moving tag, so pin
# it: docker buildx imagetools inspect registry.gitlab.com/shinobi-systems/shinobi:dev
SHINOBI_DIGEST=sha256:aa5cd83224a7d01df9b1b56d2eb637d005a3659fd97ddeeb5603f9076f08014a

# Superuser (/super panel; stored as a hash in data/shinobi/super.json). Change the default
# admin@shinobi.video / admin on first start and put the new values here.
SHINOBI_SUPER_EMAIL=
SHINOBI_SUPER_PASSWORD=

# Admin account you create in /super (stored in the Shinobi database); used by tests and tools.
SHINOBI_ADMIN_EMAIL=
SHINOBI_ADMIN_PASSWORD=

# MQTT broker URL, e.g. mqtt://localhost:1883
MQTT_URL=

# MediaMTX image tag (bluenviron/mediamtx on Docker Hub; tags have no "v" prefix)
MTX_TAG=1.21.1
